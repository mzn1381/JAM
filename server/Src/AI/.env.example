BASE_URL=your-base-url-here
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o

TRANSCRIPTION_BASE_URL=your-transcription-base-url-here
TRANSCRIPTION_API_KEY=your-transcription-api-key-here
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MAX_AUDIO_DURATION_SECONDS=15

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pishkar_ai
IDENTITY_JWT_SECRET=change-this-secret

# DEVELOPMENT | QC | STAGE | PRODUCTION
ENVIRONMENT=DEVELOPMENT 

# Comma-separated frontend origins allowed by FastAPI CORS middleware.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://web-develop.mypishkar.ir,https://assistant-develop.mypishkar.ir,https://landing-develop.mypishkar.ir,https://landing.mypishkar.ir,https://assistant-develop.mypishkar.ir

# memory or mongodb
CHECKPOINTER_PROVIDER=memory 

USAGE_BILLING_ENABLED=true

API_DOT_IR_KEY=your-api-key-here

# one year in seconds
ORGANIZATION_API_KEY_TTL_SECONDS=31536000

PHOENIX_ENDPOINT=https://phoenix-develop.mypishkar.ir/v1/traces
PHOENIX_PROJECT_NAME=default
PHOENIX_PROTOCOL=http/protobuf
PHOENIX_API_KEY=eyJ..
